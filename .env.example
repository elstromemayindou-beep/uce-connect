# Copy to .env and add values from Supabase Dashboard > Connect.
# Never commit .env or put a service_role/secret key in browser code.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Required only for admin-managed staff account creation and password resets.
# Keep this server-only; never use a VITE_ prefix or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
API_PORT=3001
APP_ORIGIN="http://localhost:5173"
# Web Push: configurez les 3 valeurs VAPID ensemble pour activer les alertes téléphone.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@votre-domaine.org"
# API.Bible: obtenir une clé et les IDs de versions dans le compte API.Bible.
# Les valeurs restent côté serveur; laisser les trois vides désactive la lecture biblique.
API_BIBLE_API_KEY=""
API_BIBLE_FRENCH_ID=""
API_BIBLE_LINGALA_ID=""
# CinetPay: remplir ensemble avec les identifiants du compte marchand UCE.
# Les clés restent uniquement côté serveur; ne jamais les préfixer avec VITE_.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
# URL HTTPS publique facultative si le reverse proxy expose le webhook ailleurs.
# CINETPAY_NOTIFY_URL="https://votre-domaine.org/api/payments/cinetpay/notify"
